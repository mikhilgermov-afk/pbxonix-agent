# This workspace is edited on Windows but everything here executes on Linux.
# A CRLF in install.sh means `#!/usr/bin/env bash\r`, which does not exist --
# the script fails on every customer PBX with an unhelpful error. Force LF.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.example   text eol=lf
Makefile    text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf

*.png       binary
*.jpg       binary
*.whl       binary
*.gz        binary
